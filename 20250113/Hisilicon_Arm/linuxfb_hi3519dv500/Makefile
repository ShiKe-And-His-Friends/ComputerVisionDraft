####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/plugins/platforms || mkdir -p $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/plugins/platforms
	$(QINSTALL_PROGRAM) ../../../../plugins/platforms/$(TARGET) $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/plugins/platforms/$(TARGET)
	-$(STRIP) --strip-unneeded $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/plugins/platforms/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/plugins/platforms/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/plugins/platforms/ 


install_cmake_qt5_plugin_file: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/lib/cmake/Qt5Gui || mkdir -p $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/lib/cmake/Qt5Gui
	$(QINSTALL) /home/ebaina/workspace/qt-everywhere-src-5.15.15/qtbase/lib/cmake/Qt5Gui/Qt5Gui_QLinuxFbIntegrationPlugin.cmake $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/lib/cmake/Qt5Gui/Qt5Gui_QLinuxFbIntegrationPlugin.cmake

uninstall_cmake_qt5_plugin_file: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/lib/cmake/Qt5Gui/Qt5Gui_QLinuxFbIntegrationPlugin.cmake
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Qt5.15.15/aarch64-v01c01-linux-gnu/lib/cmake/Qt5Gui/ 


install: install_target install_cmake_qt5_plugin_file  FORCE

uninstall: uninstall_target uninstall_cmake_qt5_plugin_file  FORCE

